@startuml
hide footbox
skinparam sequenceMessageAlign center

participant "<<class>>\nProcessor" as Processor
participant "shop:Inventory" as Inventory
participant "pen:Item" as Item

[-> Processor : process(export 1 --count=7)
activate Processor
note over Processor, Item
    Order creation and stock checks are as in
    "Creating export orders" (omitted here).
end note

Processor -> Item : reduceCount(7)
activate Item
Item --> Processor
deactivate Item

alt count is now 0
    Processor -> Inventory : removeItem(0)
    activate Inventory
    Inventory --> Processor : pen
    deactivate Inventory
    opt pen has a minimum
        note over Processor : add "Out of stock" alert
    end
else count is above 0
    Processor -> Item : isLowOnStock()
    activate Item
    Item --> Processor : true
    deactivate Item
    Processor -> Item : getShortfall()
    activate Item
    Item --> Processor : 2
    deactivate Item
    note over Processor : add "Low stock ... Reorder at least 2." alert
end

[<-- Processor : Result(order details + alert)
deactivate Processor
@enduml
