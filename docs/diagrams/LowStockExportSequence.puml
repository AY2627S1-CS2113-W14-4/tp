@startuml
hide footbox
skinparam sequenceMessageAlign center

participant "<<class>>\nOrderHandlers" as Processor
participant "shop:Inventory" as Inventory
participant "pen:Item" as Item

[-> Processor : createExport(export 1 --count=7, ...)
activate Processor
Processor -> Processor : reserveStock(c, state, shop, null)
activate Processor

ref over Processor, Item : check stock and create the export order

Processor -> Item : reduceCount(7)
activate Item
Item --> Processor
deactivate Item

alt count is now 0
    Processor -> Inventory : removeItem(0)
    activate Inventory
    Inventory --> Processor : pen
    deactivate Inventory
    opt pen has a minimum
        note over Processor : add "Out of stock" alert
    end
else count is above 0
    Processor -> Item : isLowOnStock()
    activate Item
    Item --> Processor : true
    deactivate Item
    note over Processor
        add "Low stock ... Reorder at least 2." alert;
        ResultFormatter.lowStockAlert gets the 2
        from pen.getShortfall()
    end note
end

Processor --> Processor : Result(order details + alert)
deactivate Processor
[<-- Processor : Result(order details + alert)
deactivate Processor
@enduml
