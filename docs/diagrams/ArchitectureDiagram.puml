@startuml
!pragma layout smetana
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
hide empty members

package "stockholm" {
    class StockHolm
}
package "ui" {
    class Ui
    class Printer
    class InputReader
}
package "parser" {
    class Parser
}
package "command" {
    class Command
}
package "processor" {
    class Processor
    class Result
}
package "storage" {
    class Storage
}
package "state" {
    class AppState
}
package "order" {
    class OrderHistory
}
package "inventory" {
    class Inventory
    class Item
}
package "exceptions" {
    class StockHolmException
}

StockHolm --> Ui : reads input
StockHolm --> Parser : text
StockHolm --> Processor : Command
StockHolm --> Printer : Result
StockHolm --> AppState : owns
StockHolm --> Storage : load / save
Storage ..> AppState : restores / saves
Ui --> InputReader
Ui --> Printer
Parser ..> Command : creates
Processor ..> Command : reads
Processor ..> Result : creates
Processor --> AppState : modifies
AppState --> "*" Inventory : holds (one may be current)
AppState --> "1" OrderHistory
Inventory --> "*" Item
Printer ..> Result : displays
Parser ..> StockHolmException : throws
Processor ..> StockHolmException : throws
Storage ..> StockHolmException : throws
@enduml
