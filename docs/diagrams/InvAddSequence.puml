@startuml
hide footbox
skinparam sequenceMessageAlign center

actor User
participant "<<class>>\nStockHolm" as Main
participant "<<class>>\nUi" as Ui
participant "<<class>>\nParser" as Parser
participant "<<class>>\nInventoryCommandParser" as InvParser
participant "<<class>>\nProcessor" as Processor
participant "<<class>>\nInventoryHandlers" as Handlers
participant "state:AppState" as State
participant "<<class>>\nPrinter" as Printer

[-> Main : main(args)
activate Main
loop until an exit command (one iteration shown)
    Main -> Ui : readInputFancy(null)
    activate Ui
    User -> Ui : "inv add Shop"
    Ui --> Main : "inv add Shop"
    deactivate Ui

    Main -> Parser : parseCommand("inv add Shop")
    activate Parser
    Parser -> InvParser : parseInvCommand("add Shop")
    activate InvParser
    create participant "c:Command" as Cmd
    InvParser -> Cmd : new Command(INV_ADD, {INV_NAME: "Shop"})
    activate Cmd
    Cmd --> InvParser
    deactivate Cmd
    InvParser --> Parser : c
    deactivate InvParser
    Parser --> Main : c
    deactivate Parser

    Main -> Processor : process(c, state)
    activate Processor
    note over Processor
        INV_ADD is an OUTSIDE command:
        checkLocation passes
        because no inventory is entered.
    end note
    Processor -> Handlers : add(c, state)
    activate Handlers
    Handlers -> Cmd : getArg(INV_NAME)
    activate Cmd
    Cmd --> Handlers : "Shop"
    deactivate Cmd
    Handlers -> State : findInventory("Shop")
    activate State
    State --> Handlers : inventory, or null
    deactivate State

    alt no inventory named "Shop" yet
        Handlers -> State : getInventories()
        activate State
        State --> Handlers : inventories
        deactivate State
        create participant ":Inventory" as Inv
        Handlers -> Inv : new Inventory("Shop")
        activate Inv
        Inv --> Handlers
        deactivate Inv
        note right of Handlers : adds the new inventory to inventories
        create participant "r:Result" as Res
        Handlers -> Res : new Result("Added inventory: Shop", false)
        activate Res
        Res --> Handlers
        deactivate Res
        Handlers --> Processor : r
    else "Shop" already exists
        Handlers --> Processor : throws StockHolmException
    end
    deactivate Handlers
    Processor --> Main : r, or the exception
    deactivate Processor

    alt a result was returned
        Main -> Printer : printResult(r)
        activate Printer
        Printer -> User : "Added inventory: Shop"
        Printer --> Main
        deactivate Printer
    else a StockHolmException was thrown
        Main -> Printer : printIndent(e.getMessage())
        activate Printer
        Printer -> User : "Inventory already exists: Shop"
        Printer --> Main
        deactivate Printer
    end
end
[<-- Main
deactivate Main
@enduml
