@startuml
!pragma layout smetana
hide circle
hide empty members
skinparam classAttributeIconSize 0

package "stockholm.order" {
    class Order {
        - state : OrderState
        + approve() : void
        + reject(reason : String) : void
        + cancel() : void
        + deliver() : void
    }

    class OrderHistory

    class ImportOrder
    class ExportOrder
    class TransferOrder
}

package "stockholm.inventory" {
    class Inventory
    class Item
}

Order <|-- ImportOrder
Order <|-- ExportOrder
Order <|-- TransferOrder
Order --> "1" Item : item {readOnly}
OrderHistory --> "0..*" Order : orders {ordered}
@enduml
