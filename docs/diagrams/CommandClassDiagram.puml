@startuml
!pragma layout smetana
hide circle
skinparam classAttributeIconSize 0

class "<<record>>\nCommand" as Command {
    + type() : CommandType
    + args() : Map<ArgKey, String>
    + Command(type : CommandType, args : Map<ArgKey, String>)
    + Command(type : CommandType)
    + getArg(key : ArgKey) : String
    + hasArg(key : ArgKey) : boolean
}

enum "<<enumeration>>\nCommandType" as CommandType {
    NO_OP
    HELP
    QUIT
    ENTER
    STOCK
    INV_ADD
    INV_DELETE
    INV_LIST
    BACK
    ITEM_ADD
    ITEM_LIST
    ITEM_DELETE
    IMPORT
    EXPORT
    ORDER_LIST
    APPROVE
    DELIVER
    --
    + usage() : String
    + description() : String
    + location() : Location
}

enum "<<enumeration>>\nLocation" as Location {
    ANYWHERE
    OUTSIDE
    INSIDE
    --
    + helpHeading() : String
}

enum "<<enumeration>>\nArgKey" as ArgKey {
    INV_NAME
    ITEM_NAME
    ITEM_TYPE
    ITEM_COUNT
    ITEM_INDEX
    ORDER_INDEX
    STOCK_BELOW
}

class "<<record>>\nResult" as Result {
    + message() : String
    + isExit() : boolean
}

class Parser {
    + {static} parseCommand(rawInput : String) : Command
}

class Processor {
    + {static} process(command : Command, state : AppState) : Result
}

Command --> "1" CommandType
CommandType --> "1" Location
Command --> "*" ArgKey : keys of args
Parser ..> Command : creates
Processor ..> Command : reads
Processor ..> Result : creates
@enduml
